# Secrets and host overrides for clean_fastomop. Copy to .env and fill in.

# --- Model providers (only the ones you use) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
# Key for the [models.providers.openai_compatible] endpoint (vLLM, LiteLLM, a hosted gateway)
OPENAI_COMPATIBLE_API_KEY=

# --- omcp (SQL execution): the OMOP schemas the server reads ---
CDM_SCHEMA=omop
VOCAB_SCHEMA=omop
# Optional: override the full omcp launch command (else [mcp.omcp].command is used)
# MCP_COMMAND=

# --- concept-omcp (semantic vocabulary search) ---
# Where `concept-omcp build` wrote index.turbovec + concepts.db.
# (Alternatively set [mcp.concept_omcp].artifact_dir in config.local.toml.)
CONCEPT_OMCP_ARTIFACT_DIR=/abs/path/to/concept-omcp/artifacts

# --- Observability (optional; [observability].enabled must be true) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
