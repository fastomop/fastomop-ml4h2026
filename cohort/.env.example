# Copy to .env and fill in. Loaded by python-dotenv (src/clean_fastomop_cohort/settings.py).

# --- OMOP CDM DuckDB (not shipped) ---
DUCKDB_PATH=/abs/path/to/omop.duckdb
CDM_SCHEMA=omop
VOCAB_SCHEMA=omop

# How the prompts describe the database to the model (defaults: the paper's MIMIC-IV wording)
# CDM_DESCRIPTION=a MIMIC ICU OMOP database (~65k patients)
# CDM_SHORT_DESCRIPTION=a ~65k ICU DB

# --- concept-omcp (terminology service): its index artifact dir ---
CONCEPT_OMCP_ARTIFACT_DIR=/abs/path/to/concept-omcp/artifacts

# --- Reference cohorts: a directory with index.rich.json + sources/ (see README.md) ---
GOLD_ROOT=references

# --- circe-be compiler (`clean-fastomop-cohort build-jar` compiles the wrapper; needs JDK 17) ---
CIRCE_TOOL_DIR=tools/circe-compiler
JAVA_BIN=java

# --- LLM: any OpenAI-compatible endpoint ---
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_MODEL=qwen3.8-27b
# LLM_API=ollama switches to Ollama's native /api/chat (honours LLM_THINK / OLLAMA_NUM_CTX)
LLM_API=openai
OPENAI_MODEL_BUILDER=
OPENAI_MODEL_CRITIC=
LLM_TIMEOUT_S=600
LLM_MAX_RETRIES=0
LLM_TURN_RETRIES=4
OLLAMA_NUM_CTX=0
# Critic check-and-revise rounds per cohort; LLM_TRACE=1 logs one line per turn
CRITIC_MAX_ROUNDS=3
LLM_TRACE=1
LLM_THINK=

# --- Azure OpenAI (fallback when OPENAI_API_KEY is empty) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=
